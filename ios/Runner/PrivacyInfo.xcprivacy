<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Round-6 audit CRITICAL fix: Apple hard-rejects (ITMS-91053) any app
  submitted without a privacy manifest since 2024-11-12. This file
  declares the Required Reason APIs used by our SDK set (Firebase +
  Stripe + flutter_local_notifications + Hive) and the data types
  collected.

  IMPORTANT — Xcode setup (do on Mac before first upload):
    1. Open ios/Runner.xcworkspace
    2. Right-click Runner group → Add Files to "Runner"
    3. Select this file (PrivacyInfo.xcprivacy)
    4. Ensure "Copy items if needed" is unchecked, target Runner IS checked
    5. Verify Target Runner → Build Phases → Copy Bundle Resources
       contains this file (Xcode may add it under a "Resources" build
       phase automatically).

  Third-party SDKs (Firebase pods, Stripe pods) ship their own privacy
  manifests as of current versions — CocoaPods merges them at build.
  This file only covers what OUR app code uses directly.
-->
<plist version="1.0">
<dict>
    <key>NSPrivacyTracking</key>
    <true/>
    <!--
      Domains Firebase Analytics + Crashlytics reach when the user grants
      ATT (setAnalyticsCollectionEnabled(true) after
      requestTrackingAuthorization). Apple hard-rejects binaries that
      declare NSPrivacyTracking=true with an empty domains array — it
      reads as "we track but won't say where". If in the future we drop
      ATT entirely (never call requestTrackingAuthorization), flip
      NSPrivacyTracking to false and empty this array in the same commit.
    -->
    <key>NSPrivacyTrackingDomains</key>
    <array>
        <string>app-measurement.com</string>
        <string>firebase-settings.crashlytics.com</string>
        <string>firebase-crashlytics-reports-pa.googleapis.com</string>
    </array>
    <key>NSPrivacyCollectedDataTypes</key>
    <array>
        <dict>
            <key>NSPrivacyCollectedDataType</key>
            <string>NSPrivacyCollectedDataTypeCrashData</string>
            <key>NSPrivacyCollectedDataTypeLinked</key>
            <false/>
            <key>NSPrivacyCollectedDataTypeTracking</key>
            <false/>
            <key>NSPrivacyCollectedDataTypePurposes</key>
            <array>
                <string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
            </array>
        </dict>
        <dict>
            <key>NSPrivacyCollectedDataType</key>
            <string>NSPrivacyCollectedDataTypePerformanceData</string>
            <key>NSPrivacyCollectedDataTypeLinked</key>
            <false/>
            <key>NSPrivacyCollectedDataTypeTracking</key>
            <false/>
            <key>NSPrivacyCollectedDataTypePurposes</key>
            <array>
                <string>NSPrivacyCollectedDataTypePurposeAnalytics</string>
            </array>
        </dict>
        <dict>
            <key>NSPrivacyCollectedDataType</key>
            <string>NSPrivacyCollectedDataTypeOtherDiagnosticData</string>
            <key>NSPrivacyCollectedDataTypeLinked</key>
            <false/>
            <key>NSPrivacyCollectedDataTypeTracking</key>
            <false/>
            <key>NSPrivacyCollectedDataTypePurposes</key>
            <array>
                <string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
            </array>
        </dict>
        <dict>
            <key>NSPrivacyCollectedDataType</key>
            <string>NSPrivacyCollectedDataTypeEmailAddress</string>
            <key>NSPrivacyCollectedDataTypeLinked</key>
            <true/>
            <key>NSPrivacyCollectedDataTypeTracking</key>
            <false/>
            <key>NSPrivacyCollectedDataTypePurposes</key>
            <array>
                <string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
            </array>
        </dict>
        <dict>
            <key>NSPrivacyCollectedDataType</key>
            <string>NSPrivacyCollectedDataTypeName</string>
            <key>NSPrivacyCollectedDataTypeLinked</key>
            <true/>
            <key>NSPrivacyCollectedDataTypeTracking</key>
            <false/>
            <key>NSPrivacyCollectedDataTypePurposes</key>
            <array>
                <string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
            </array>
        </dict>
        <dict>
            <key>NSPrivacyCollectedDataType</key>
            <string>NSPrivacyCollectedDataTypeUserID</string>
            <key>NSPrivacyCollectedDataTypeLinked</key>
            <true/>
            <key>NSPrivacyCollectedDataTypeTracking</key>
            <false/>
            <key>NSPrivacyCollectedDataTypePurposes</key>
            <array>
                <string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
            </array>
        </dict>
        <dict>
            <key>NSPrivacyCollectedDataType</key>
            <string>NSPrivacyCollectedDataTypePaymentInfo</string>
            <key>NSPrivacyCollectedDataTypeLinked</key>
            <true/>
            <key>NSPrivacyCollectedDataTypeTracking</key>
            <false/>
            <key>NSPrivacyCollectedDataTypePurposes</key>
            <array>
                <string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
            </array>
        </dict>
        <dict>
