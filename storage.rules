rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /profile_photos/{fileName} {
      // BUG-039 fix (Audit Round 4 Phase 5): direct Storage SDK reads are
      // scoped to the owner. Leaderboard / CRM avatars keep working because
      // Flutter (and the admin web) load photos via the `getDownloadURL()`
      // token URL — that signed URL bypasses Storage rules entirely, so any
      // client holding the URL can fetch the asset. The rule below only
      // gates *enumeration* and SDK-style fetches that don't include the
      // download token, blocking a malicious caller from scraping every
      // donor face by iterating `profile_photos/{uid}.jpg` directly.
      allow read: if request.auth != null
                   && fileName == request.auth.uid + '.jpg';

      // Writes restricted to the owner uploading <their-uid>.jpg only.
      // Constraints prevent uploading on behalf of other users, oversize
      // files (5 MB), or non-image content types.
      allow write: if request.auth != null
                   && fileName == request.auth.uid + '.jpg'
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }
    // Default-deny everything else — without this, any path under the bucket
    // not explicitly matched would deny by default ANYWAY in v2 rules, but
    // making it explicit guards against accidentally adding a too-permissive
    // wildcard later.
    match /{path=**} {
      allow read, write: if false;
    }
  }
}
