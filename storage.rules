rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /profile_photos/{fileName} {
      // Reads scoped to authenticated users. Note: Flutter clients fetch
      // photos via the `getDownloadURL()` token URL which bypasses these
      // rules entirely (Firebase Storage download URLs are signed and
      // valid for anyone who holds them). This rule only gates direct
      // Storage SDK reads — leaving it open to any auth'd user matches
      // how donor avatars are surfaced in tenant leaderboards. To tighten
      // further would require switching to short-lived signed URLs (a
      // larger change) and would still not stop URL-based fetches.
      allow read: if request.auth != null;

      // Writes restricted to the owner uploading <their-uid>.jpg only.
      // Constraints prevent uploading on behalf of other users, oversize
      // files (5 MB), or non-image content types.
      allow write: if request.auth != null
                   && fileName == request.auth.uid + '.jpg'
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }
    // Default-deny everything else — without this, any path under the bucket
    // not explicitly matched would deny by default ANYWAY in v2 rules, but
    // making it explicit guards against accidentally adding a too-permissive
    // wildcard later.
    match /{path=**} {
      allow read, write: if false;
    }
  }
}
