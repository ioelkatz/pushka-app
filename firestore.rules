rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.admin == true ||
        request.auth.token.role == 'super_admin'
      );
    }

    function isSuperAdmin() {
      return isSignedIn() && request.auth.token.role == 'super_admin';
    }

    function isTenantAdmin() {
      return isSignedIn() && request.auth.token.role == 'tenant_admin';
    }

    function isTenantCollaborator() {
      return isSignedIn() && request.auth.token.role == 'tenant_collaborator';
    }

    function callerTenantId() {
      return request.auth.token.tenantId;
    }

    function isTenantMember() {
      return isTenantAdmin() || isTenantCollaborator();
    }

    function validFrequency(value) {
      return value == 'manual' ||
          value == 'weekly' ||
          value == 'monthly' ||
          value == 'erev_rosh_chodesh';
    }

    // Round-6 audit MEDIUM fix: whitelist matches functions/index.js
    // CURRENCY_MINIMUMS keys (uppercase — client always sends uppercase).
    // Without this any 3-char string passed (e.g. 'XYZ' or an emoji) and
    // downstream admin FX aggregations silently misconverted. MUST stay
    // in sync with SUPPORTED_CURRENCIES on the server.
    function validCurrencyCode(code) {
      return code == 'USD' || code == 'EUR' || code == 'GBP' || code == 'CAD' ||
          code == 'ILS' || code == 'MXN' || code == 'BRL' || code == 'ARS' ||
          code == 'CLP' || code == 'COP';
    }

    // tenantId on users/{uid} must reference an existing tenants/{id} document.
    // Without this, any user could self-assign an arbitrary tenantId string
    // and appear as a member of that tenant in `where(tenantId == X)` queries.
    function validTenantIdField() {
      return !('tenantId' in request.resource.data) ||
          (request.resource.data.tenantId is string &&
              request.resource.data.tenantId.size() > 0 &&
              request.resource.data.tenantId.size() <= 50 &&
              exists(/databases/$(database)/documents/tenants/$(request.resource.data.tenantId)));
    }

    // Fields that only Cloud Functions may write (server-side only).
    // hasNoStripeFields() is for CREATE (new doc must not contain them).
    // hasNoStripeFieldsWritten() is for UPDATE (checks the diff — existing CF-written
    // Stripe fields in the resulting doc are fine; writing/changing them is not).
    function hasNoStripeFields() {
      return !('stripeCustomerId' in request.resource.data) &&
             !('stripeDefaultPaymentMethodId' in request.resource.data) &&
             !('stripeDefaultPaymentMethodLast4' in request.resource.data) &&
             !('stripeDefaultPaymentMethodBrand' in request.resource.data) &&
             !('stripeCustomerIdPending' in request.resource.data);
    }

    function hasNoStripeFieldsWritten() {
      // On UPDATE, request.resource.data is the full resulting document — it may
      // include Stripe fields that Cloud Functions previously wrote (Admin SDK bypasses
      // rules). We must only check what is being *changed*, not what's already there.
      return !request.resource.data.diff(resource.data).affectedKeys()
               .hasAny(['stripeCustomerId',
                        'stripeDefaultPaymentMethodId',
                        'stripeDefaultPaymentMethodLast4',
                        'stripeDefaultPaymentMethodBrand',
                        'stripeCustomerIdPending']);
    }

    function isBlockedNotChanged() {
      // isBlocked is written exclusively by Cloud Functions (Admin SDK bypasses rules).
      // Clients may not change this field — only read it.
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['isBlocked']);
    }

    // tenantId, tenantIds, and isAdmin* are managed exclusively by the
    // joinTenant / leaveTenant / switchTenant / setAdminClaim Cloud Functions
    // (Admin SDK). Clients may not write these fields directly. Without
    // including tenantId here, a client could self-attach to any tenant on
    // the user-doc UPDATE path (the create path was already protected by
    // isOwner-only writes; this closes the update vector).
    function hasNoMembershipFieldsWritten() {
      return !request.resource.data.diff(resource.data).affectedKeys()
               .hasAny(['tenantIds', 'tenantId']);
    }

    // For CREATE: forbid tenantId entirely. Tenant attachment must flow
    // through the joinTenant CF (which validates the invite/slug). Without
    // this, a malicious client could create users/{uid} with any existing
    // tenantId and appear in that tenant's admin dashboards.
    function hasNoTenantIdField() {
      return !('tenantId' in request.resource.data) &&
             !('tenantIds' in request.resource.data);
    }

    // Client-writable tenantState keys. Used for create (hasOnly on full doc)
    // and update (affectedKeys — so CF-written fields already in the doc don't
    // block the write even if they're not in this list).
    function tenantStateClientKeys() {
      return ['uid', 'tenantId',
              'tenantName', 'tenantAppName', 'tenantLogoUrl', 'tenantPrimaryColor',
              'tenantContactPhone', 'tenantDonationReasons',
              'pushkaAmount', 'pushkaGoal',
              'presetAmount', 'presetAmounts',
              'streakCount', 'lastStreakDate',
              'autoEmptyFrequency', 'autoEmptyWeekday', 'autoEmptyDayOfMonth',
              'autoEmptyTopOffEnabled', 'autoEmptyTopOffAmount', 'autoEmptyNextRunAt',
              // autoEmptyTopOffCurrency lo escribe el cliente desde el Round-4
              // audit (sella la moneda en la que se configuro el top-off para
              // que el cron detecte drift) pero NUNCA se agrego aca. Resultado:
              // hasOnly() rechazaba TODO guardado de auto-vaciado no manual y
              // el usuario solo veia "Error al guardar. Intenta nuevamente.".
              'autoEmptyTopOffCurrency',
              'autoEmptyPaymentMethodId', 'autoEmptyDonationReason',
              'createdAt', 'updatedAt'];
    }

    // Field-value validations shared by create and update.
    function validTenantStateFields(uid, tenantId) {
      return request.resource.data.uid == uid &&
          request.resource.data.tenantId == tenantId &&
          (!('pushkaAmount' in request.resource.data) ||
              (request.resource.data.pushkaAmount is number &&
                  request.resource.data.pushkaAmount >= 0 &&
                  request.resource.data.pushkaAmount <= 10000000)) &&
          (!('pushkaGoal' in request.resource.data) ||
              (request.resource.data.pushkaGoal is number &&
                  request.resource.data.pushkaGoal > 0 &&
                  request.resource.data.pushkaGoal <= 10000000)) &&
          (!('presetAmount' in request.resource.data) ||
              (request.resource.data.presetAmount is number &&
                  request.resource.data.presetAmount > 0)) &&
          (!('presetAmounts' in request.resource.data) ||
              (request.resource.data.presetAmounts is list &&
                  request.resource.data.presetAmounts.size() <= 5)) &&
          (!('streakCount' in request.resource.data) ||
              (request.resource.data.streakCount is int &&
                  request.resource.data.streakCount >= 0)) &&
          (!('autoEmptyFrequency' in request.resource.data) ||
              (request.resource.data.autoEmptyFrequency is string &&
                  validFrequency(request.resource.data.autoEmptyFrequency))) &&
          (!('autoEmptyWeekday' in request.resource.data) ||
              request.resource.data.autoEmptyWeekday == null ||
              (request.resource.data.autoEmptyWeekday is int &&
                  request.resource.data.autoEmptyWeekday >= 1 &&
                  request.resource.data.autoEmptyWeekday <= 7)) &&
          (!('autoEmptyDayOfMonth' in request.resource.data) ||
              request.resource.data.autoEmptyDayOfMonth == null ||
              (request.resource.data.autoEmptyDayOfMonth is int &&
                  request.resource.data.autoEmptyDayOfMonth >= 1 &&
                  request.resource.data.autoEmptyDayOfMonth <= 31)) &&
          (!('autoEmptyTopOffEnabled' in request.resource.data) ||
              request.resource.data.autoEmptyTopOffEnabled is bool) &&
          (!('autoEmptyTopOffAmount' in request.resource.data) ||
              request.resource.data.autoEmptyTopOffAmount == null ||
              (request.resource.data.autoEmptyTopOffAmount is number &&
                  request.resource.data.autoEmptyTopOffAmount >= 0 &&
                  request.resource.data.autoEmptyTopOffAmount <= 10000000)) &&
          // Moneda en la que se configuro el top-off. Se valida contra la misma
          // lista que el resto de la app: SUPPORTED_CURRENCIES en
          // functions/index.js son exactamente estas 10, asi que un usuario no
          // puede terminar con una moneda que esta regla rechace.
          (!('autoEmptyTopOffCurrency' in request.resource.data) ||
              request.resource.data.autoEmptyTopOffCurrency == null ||
              (request.resource.data.autoEmptyTopOffCurrency is string &&
                  validCurrencyCode(request.resource.data.autoEmptyTopOffCurrency))) &&
          (!('autoEmptyNextRunAt' in request.resource.data) ||
              request.resource.data.autoEmptyNextRunAt == null ||
              (request.resource.data.autoEmptyNextRunAt is timestamp &&
                  (request.resource.data.autoEmptyNextRunAt > request.time ||
                      (resource != null &&
                          resource.data.get('autoEmptyNextRunAt', null) == request.resource.data.autoEmptyNextRunAt)))) &&
          (!('autoEmptyPaymentMethodId' in request.resource.data) ||
              request.resource.data.autoEmptyPaymentMethodId == null ||
              (request.resource.data.autoEmptyPaymentMethodId is string &&
                  request.resource.data.autoEmptyPaymentMethodId.size() <= 100)) &&
          // autoEmptyDonationReason: optional per-tenant designation that
          // the cron threads into PaymentIntent.metadata so the org can
          // attribute the scheduled donation. Null clears it.
          (!('autoEmptyDonationReason' in request.resource.data) ||
              request.resource.data.autoEmptyDonationReason == null ||
              (request.resource.data.autoEmptyDonationReason is string &&
                  request.resource.data.autoEmptyDonationReason.size() <= 80));
    }

    // CREATE: full new doc must only contain client-writable keys + field validations.
    function validTenantStateDoc(uid, tenantId) {
      return request.resource.data.keys().hasOnly(tenantStateClientKeys()) &&
          validTenantStateFields(uid, tenantId);
    }

    // UPDATE: only check which keys are being CHANGED (affectedKeys), not the
    // full resulting document. This prevents CF-written fields already in the
    // document (_autoEmptyChargeLockAt, autoEmptyConsecutiveFailures, etc.)
    // from blocking legitimate client updates to presets, goal, etc.
    function validTenantStateUpdateDoc(uid, tenantId) {
      return request.resource.data.diff(resource.data).affectedKeys()
                  .hasOnly(tenantStateClientKeys()) &&
          validTenantStateFields(uid, tenantId);
    }

    function validUserDoc(uid) {
      // hasOnly includes Stripe fields and isBlocked so that on UPDATE, pre-existing
      // CF-written fields in the resulting document don't fail the check.
      // Writing/changing those fields is separately blocked by the specific guards below.
      //
      // BUG #17 note: `_lastPmDedupePassAt` and the flat `stripeCustomer*` /
      // `stripeDefaultPayment*` fields below are DEPRECATED post-Direct-Charges
      // migration — CFs write them nowhere anymore, they moved to
      // users/{uid}/tenantState/{tid}.stripeConnect*. They stay in this
      // whitelist ONLY to grandfather pre-migration users who still have
      // those fields on their user doc: without them here, any client
      // update to the doc (pushkaAmount, language, etc.) would fail
      // hasOnly because the resulting doc still has the legacy field.
      // A future migration CF can strip these + drop them from the whitelist.
      return request.resource.data.keys().hasOnly([
            'uid',
            'email',
            'displayName',
            'photoURL',
            'createdAt',
            'lastLoginAt',
            'billingEmail',
            'phoneNumber',
            'mailingAddress',
            'pushkaAmount',
            'pushkaGoal',
            'presetAmount',
            'presetAmounts',
            'soundEnabled',
            'coinJingleEnabled',
            'vibrationEnabled',
            'ambientEnabled',
            'partialPaymentsEnabled',
            'additionalPaymentOptionsEnabled',
            'biometricAuthenticationEnabled',
            'currencyCountry',
            'currencyCode',
            'autoEmptyFrequency',
            'autoEmptyWeekday',
            'autoEmptyDayOfMonth',
            'autoEmptyTopOffEnabled',
            'autoEmptyTopOffAmount',
            'autoEmptyNextRunAt',
            'lastStreakDate',
            'streakCount',
            'reminderCount',
            'onboardingCompleted',
            'language',
            'updatedAt',
            'stripeCustomerId',
            'stripeDefaultPaymentMethodId',
            'stripeDefaultPaymentMethodLast4',
            'stripeDefaultPaymentMethodBrand',
            'stripeCustomerIdPending',
            'isBlocked',
            'tenantId',
            'tenantIds',
            '_lastPmDedupePassAt',
            'timezone'
          ]) &&
          request.resource.data.uid is string &&
          request.resource.data.uid == uid &&
          (!('pushkaAmount' in request.resource.data) ||
              (request.resource.data.pushkaAmount is number &&
                  request.resource.data.pushkaAmount >= 0 &&
                  request.resource.data.pushkaAmount <= 10000000)) &&
          (!('pushkaGoal' in request.resource.data) ||
              (request.resource.data.pushkaGoal is number &&
                  request.resource.data.pushkaGoal > 0 &&
                  request.resource.data.pushkaGoal <= 10000000)) &&
          (!('presetAmount' in request.resource.data) ||
              (request.resource.data.presetAmount is number &&
                  request.resource.data.presetAmount > 0)) &&
          (!('presetAmounts' in request.resource.data) ||
              (request.resource.data.presetAmounts is list &&
                  request.resource.data.presetAmounts.size() <= 5)) &&
          (!('soundEnabled' in request.resource.data) ||
              request.resource.data.soundEnabled is bool) &&
          (!('coinJingleEnabled' in request.resource.data) ||
              request.resource.data.coinJingleEnabled is bool) &&
          (!('vibrationEnabled' in request.resource.data) ||
              request.resource.data.vibrationEnabled is bool) &&
          (!('ambientEnabled' in request.resource.data) ||
              request.resource.data.ambientEnabled is bool) &&
          (!('partialPaymentsEnabled' in request.resource.data) ||
              request.resource.data.partialPaymentsEnabled is bool) &&
          (!('additionalPaymentOptionsEnabled' in request.resource.data) ||
              request.resource.data.additionalPaymentOptionsEnabled is bool) &&
          (!('biometricAuthenticationEnabled' in request.resource.data) ||
              request.resource.data.biometricAuthenticationEnabled is bool) &&
          (!('currencyCountry' in request.resource.data) ||
              request.resource.data.currencyCountry is string) &&
          (!('currencyCode' in request.resource.data) ||
              (request.resource.data.currencyCode is string &&
                  validCurrencyCode(request.resource.data.currencyCode))) &&
          (!('autoEmptyFrequency' in request.resource.data) ||
              (request.resource.data.autoEmptyFrequency is string &&
                  validFrequency(request.resource.data.autoEmptyFrequency))) &&
          (!('autoEmptyWeekday' in request.resource.data) ||
              (request.resource.data.autoEmptyWeekday is int &&
                  request.resource.data.autoEmptyWeekday >= 1 &&
                  request.resource.data.autoEmptyWeekday <= 7)) &&
          (!('autoEmptyDayOfMonth' in request.resource.data) ||
              (request.resource.data.autoEmptyDayOfMonth is int &&
                  request.resource.data.autoEmptyDayOfMonth >= 1 &&
                  request.resource.data.autoEmptyDayOfMonth <= 31)) &&
          (!('autoEmptyTopOffEnabled' in request.resource.data) ||
              request.resource.data.autoEmptyTopOffEnabled is bool) &&
          (!('autoEmptyTopOffAmount' in request.resource.data) ||
              (request.resource.data.autoEmptyTopOffAmount is number &&
                  request.resource.data.autoEmptyTopOffAmount >= 0 &&
                  request.resource.data.autoEmptyTopOffAmount <= 10000000)) &&
          (!('autoEmptyNextRunAt' in request.resource.data) ||
              request.resource.data.autoEmptyNextRunAt == null ||
              (request.resource.data.autoEmptyNextRunAt is timestamp &&
                  (request.resource.data.autoEmptyNextRunAt > request.time ||
                      (resource != null &&
                          resource.data.get('autoEmptyNextRunAt', null) == request.resource.data.autoEmptyNextRunAt)))) &&
          // timezone: IANA name (e.g. 'America/Mexico_City'). Used by the
          // server-side reminders scheduler to compute nextTriggerAt in the
          // user's local time. IANA names are max ~40 chars — cap at 60 as
          // generous slack. Empty string rejected (would confuse the CF).
          (!('timezone' in request.resource.data) ||
              (request.resource.data.timezone is string &&
                  request.resource.data.timezone.size() > 0 &&
                  request.resource.data.timezone.size() <= 60)) &&
          // Round-6 audit MEDIUM fix: email must match the incoming Auth
          // token email + basic format check. Previously any string was
          // accepted, letting a client rewrite users/{uid}.email to an
          // arbitrary value and impersonate another user across features
          // that key off email (e.g. pending tenant admin invites, weekly
          // summary "from" field). Immutable-once-set: if the doc already
          // has an email, client can't change it — only the CF onUserDocCreated
          // (Admin SDK, bypasses rules) can rewrite.
          (!('email' in request.resource.data) ||
              (request.resource.data.email is string &&
                  request.resource.data.email.size() <= 254 &&
                  request.resource.data.email.matches('.+@.+\\..+') &&
                  (resource == null ||
                      !('email' in resource.data) ||
                      resource.data.email == request.resource.data.email))) &&
          // displayName: cap length AND require at least one non-whitespace
          // char. A name of "   " passes the size check but renders as a blank
          // chip across the UI (donor lists, top-donors leaderboard, history
          // attribution). Trim happens client-side as cleanup; the rule is
          // the authoritative server-side floor.
          (!('displayName' in request.resource.data) ||
              (request.resource.data.displayName is string &&
                  request.resource.data.displayName.size() <= 100 &&
                  request.resource.data.displayName.trim().size() >= 1)) &&
          (!('billingEmail' in request.resource.data) ||
              (request.resource.data.billingEmail is string &&
                  request.resource.data.billingEmail.size() <= 254)) &&
          (!('phoneNumber' in request.resource.data) ||
              (request.resource.data.phoneNumber is string &&
                  request.resource.data.phoneNumber.size() <= 30)) &&
          (!('mailingAddress' in request.resource.data) ||
              (request.resource.data.mailingAddress is string &&
                  request.resource.data.mailingAddress.size() <= 500)) &&
          (!('photoURL' in request.resource.data) ||
              (request.resource.data.photoURL is string &&
                  request.resource.data.photoURL.size() <= 2048)) &&
          (!('reminderCount' in request.resource.data) ||
              (request.resource.data.reminderCount is int &&
                  request.resource.data.reminderCount >= 0)) &&
          (!('onboardingCompleted' in request.resource.data) ||
              request.resource.data.onboardingCompleted is bool) &&
          (!('language' in request.resource.data) ||
              (request.resource.data.language is string &&
                  (request.resource.data.language == 'es' ||
                      request.resource.data.language == 'en' ||
                      request.resource.data.language == 'fr' ||
                      request.resource.data.language == 'he')));
    }

    function validTransactionDoc() {
      return request.resource.data.keys().hasOnly([
            'type',
            'amount',
            'description',
            'paymentMethod',
            'status',
            'currencyCode',
            'tenantId',
            'donationReason',
            'createdAt'
          ]) &&
          (request.resource.data.type == 'tzedaka' ||
              request.resource.data.type == 'pushkaEmpty') &&
          request.resource.data.amount is number &&
          // Amount must be positive and within a sane ceiling. Cap is in MAJOR
          // currency units — must accommodate ARS/CLP/COP/MXN where a routine
          // donation can exceed millions of pesos. 10 million covers a
          // legitimate $50K USD donation in ARS at peak inflation.
          request.resource.data.amount > 0 &&
          request.resource.data.amount <= 10000000 &&
          // createdAt must equal the server request time — prevents backdating / future-dating.
          request.resource.data.createdAt == request.time &&
          (!('description' in request.resource.data) ||
              (request.resource.data.description is string &&
                  request.resource.data.description.size() <= 500)) &&
          // paymentMethod is required for client-written transactions and must
          // NOT be 'card' / 'auto_card' — those are exclusively webhook-written
          // via Admin SDK (which bypasses these rules). This prevents a
          // malicious client from inflating their own donation history with
          // fake card transactions, and from creating a phantom record
          // alongside the legitimate webhook-written one.
          // Round-6 audit HIGH fix: positive whitelist instead of blacklist.
          // The blacklist (paymentMethod != 'card' && != 'auto_card' && != 'auto')
          // let anything else through — a client with a bug (unknown enum
          // value) or a malicious payload with 'unknown_method' would pass,
          // and downstream aggregations that fall back to 'card' would
          // silently inflate card revenue. The card/auto/auto_card methods
          // are ONLY written by the Stripe webhook via Admin SDK (bypasses
          // these rules).
          ('paymentMethod' in request.resource.data) &&
          request.resource.data.paymentMethod is string &&
          request.resource.data.paymentMethod.size() <= 100 &&
          (request.resource.data.paymentMethod == 'check' ||
              request.resource.data.paymentMethod == 'transfer' ||
              request.resource.data.paymentMethod == 'daf' ||
              request.resource.data.paymentMethod == 'other') &&
          // status is REQUIRED on client-written transactions and must be one of
          // a known enum. Without this, downstream aggregations would treat a
          // missing status as "completed" and inflate stats with rows the
          // server never observed (and can't reconcile with Stripe).
          ('status' in request.resource.data) &&
          request.resource.data.status is string &&
          (request.resource.data.status == 'pending' ||
              request.resource.data.status == 'completed' ||
              request.resource.data.status == 'failed') &&
          // currencyCode is REQUIRED — multi-tenant aggregations rely on it for
          // FX conversion. Missing currencyCode silently corrupts admin reports.
          ('currencyCode' in request.resource.data) &&
          request.resource.data.currencyCode is string &&
          validCurrencyCode(request.resource.data.currencyCode) &&
          // tenantId is REQUIRED and must match the user's active tenant. This
          // prevents (a) tenant-less transactions invisible to history queries
          // and (b) tagging a donation as belonging to a tenant the user is
          // not currently operating in.
          ('tenantId' in request.resource.data) &&
          request.resource.data.tenantId is string &&
          request.resource.data.tenantId == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.tenantId;
    }

    function validReminderDoc() {
      return request.resource.data.keys().hasOnly([
            'title',
            'timeHour',
            'timeMinute',
            'days',
            'isHoliday',
            'minutesBefore',
            'isEnabled',
            'secondTimeHour',
            'secondTimeMinute',
            'secondDays',
            'secondIsHoliday',
            'oneShotDate',
            'createdAt',
            // Server-owned fields (populated by onReminderWrite +
            // processDueReminders via Admin SDK). Included in the allowlist
            // because client updates use set(..., merge:true), which causes
            // request.resource.data to be the RESULTING MERGED document —
            // so once the CF has stamped these, subsequent client updates
            // carry them through the merge and would otherwise fail
            // hasOnly(). Client mutation is blocked separately by
            // hasNoServerOnlyReminderFieldsWritten() (immutable-from-client).
            'nextTriggerAt',
            'lastTriggeredAt',
            'timezone'
          ]) &&
          request.resource.data.title is string &&
          request.resource.data.title.size() <= 100 &&
          request.resource.data.timeHour is int &&
          request.resource.data.timeHour >= 0 &&
          request.resource.data.timeHour <= 23 &&
          request.resource.data.timeMinute is int &&
          request.resource.data.timeMinute >= 0 &&
          request.resource.data.timeMinute <= 59 &&
          request.resource.data.days is list &&
          request.resource.data.days.size() <= 7 &&
          request.resource.data.isHoliday is bool &&
          (!('minutesBefore' in request.resource.data) ||
              request.resource.data.minutesBefore == null ||
              (request.resource.data.minutesBefore is int &&
                  request.resource.data.minutesBefore >= 0 &&
                  request.resource.data.minutesBefore <= 1440)) &&
          request.resource.data.isEnabled is bool &&
          request.resource.data.secondDays is list &&
          request.resource.data.secondDays.size() <= 7 &&
          request.resource.data.secondIsHoliday is bool &&
          (
            (
              (!('secondTimeHour' in request.resource.data) || request.resource.data.secondTimeHour == null) &&
              (!('secondTimeMinute' in request.resource.data) || request.resource.data.secondTimeMinute == null)
            ) ||
            (
              request.resource.data.secondTimeHour is int &&
              request.resource.data.secondTimeHour >= 0 &&
              request.resource.data.secondTimeHour <= 23 &&
              request.resource.data.secondTimeMinute is int &&
              request.resource.data.secondTimeMinute >= 0 &&
              request.resource.data.secondTimeMinute <= 59
            )
          ) &&
          // oneShotDate: nullable Timestamp for chooseDate one-shot reminders.
          // Server-side scheduling computes `nextTriggerAt` from it. Client
          // sets it when the user picks a date; may be omitted for recurring.
          (!('oneShotDate' in request.resource.data) ||
              request.resource.data.oneShotDate == null ||
              request.resource.data.oneShotDate is timestamp);
    }

    // Server-owned reminder fields — populated by onReminderWrite +
    // processDueReminders. Clients MUST NOT MUTATE them.
    //
    // On CREATE (resource == null): require the fields be ABSENT — the
    // client has no business seeding server-scheduler state.
    //
    // On UPDATE: require each field's post-write value == pre-write value.
    //   Previous version used `!('field' in request.resource.data)` on both
    //   create and update. That was correct for `.update()` writes but WRONG
    //   for `.set(..., merge: true)`: with merge, request.resource.data is
    //   the RESULTING MERGED document, so pre-existing server-owned fields
    //   get carried through the merge and appear in request.resource.data.
    //   Result: the very first client update to any reminder that had already
    //   been touched by onReminderWrite (i.e. any reminder in the wild)
    //   failed with PERMISSION_DENIED — surfaced in the app as
    //   "Could not update reminder". The equality check below correctly
    //   allows the client to keep the existing server-owned values through
    //   the merge, while still blocking any attempt to alter them.
    function hasNoServerOnlyReminderFieldsWritten() {
      return resource == null
          ? (!('nextTriggerAt' in request.resource.data) &&
              !('lastTriggeredAt' in request.resource.data) &&
              !('timezone' in request.resource.data))
          : (request.resource.data.get('nextTriggerAt', null) ==
                  resource.data.get('nextTriggerAt', null) &&
              request.resource.data.get('lastTriggeredAt', null) ==
                  resource.data.get('lastTriggeredAt', null) &&
              request.resource.data.get('timezone', null) ==
                  resource.data.get('timezone', null));
    }

    function validTokenDoc(tokenId) {
      return request.resource.data.keys().hasOnly([
            'token',
            'platform',
            'createdAt',
            'lastUsedAt'
          ]) &&
          request.resource.data.token is string &&
          // FCM tokens are typically 140–200 characters; reject obviously bogus values.
          request.resource.data.token.size() >= 100 &&
          request.resource.data.token.size() <= 4096 &&
          request.resource.data.token == tokenId &&
          request.resource.data.platform is string &&
          (request.resource.data.platform == 'android' ||
              request.resource.data.platform == 'ios' ||
              request.resource.data.platform == 'web');
    }

    // Tenants — branding and config for each organization.
    //
    // Writes from clients are forbidden ENTIRELY — tenant CRUD must flow
    // through the createTenant / updateTenant Cloud Functions, which (a)
    // verify FRESH super_admin claims (not a 1h-stale token), (b) maintain
    // the `_tenantSlugs/{slug}` lock collection on slug changes, and (c)
    // fan out branding changes to member tenantState docs via the
    // onTenantBrandingUpdated trigger. A direct super_admin write here
    // would bypass slug uniqueness and silently desync the lock collection.
    match /tenants/{tenantId} {
      // Super admin: full read. Tenant admin/collaborator: read their own
      // tenant (for branding/config rendering).
      allow read: if isAdmin() ||
        (isTenantMember() && callerTenantId() == tenantId);
      allow write: if false;
    }

    // Internal collections — server-side only, deny all client access.
    match /_rateLimits/{document=**} {
      allow read, write: if false;
    }
    match /_exchangeRates/{document=**} {
      allow read, write: if false;
    }
    match /_tenantSlugs/{slug} {
      allow read, write: if false;
    }
    match /_stripeConnectOAuth/{stateToken} {
      // Stripe Connect OAuth state tokens (CSRF nonce → tenantId +
      // callerUid + 24h expiry). Server-only: previously stored on
      // tenants/{id}, but any tenant member can read that doc — a
      // tenant_collaborator could steal the state, complete OAuth with
      // their own Stripe account, and hijack donations. Cloud Functions
      // (createStripeConnectLink writes, handleStripeConnectOAuth reads
      // + deletes) use admin SDK and bypass these rules.
      allow read, write: if false;
    }
    match /_stripeWebhookEvents/{document=**} {
      allow read, write: if false;
    }
    match /_monthlyActive/{document=**} {
      allow read, write: if false;
    }
    match /_backfillRuns/{document=**} {
      allow read, write: if false;
    }
    match /_appConfig/{document=**} {
      allow read, write: if false;
    }
    match /_pendingTenantAdmins/{document=**} {
      // Pending tenant_admin invitations — server-only via Cloud Functions
      // (setAdminClaim writes, claimPendingTenantAdmin reads + deletes).
      // No client access: leaking the document set would reveal who has been
      // invited but not yet signed up, and a forged write would let any
      // user grant themselves a tenant_admin claim on next sign-in.
      allow read, write: if false;
    }

    // Admin-only config and notes collections
    match /adminConfig/{document} {
      allow read, write: if isAdmin();
    }

    // Activity log — super_admin read/write only (tenant roles never see this)
    match /_activityLog/{docId} {
      allow read, write: if isAdmin();
    }

    match /adminData/{uid} {
      // adminData stores per-user moderation state (isBlocked, admin notes).
      // Tenant_admin/collaborator from tenant A previously could read
      // adminData for users in tenant B (cross-tenant moderation leak).
      // Tightened to: the user themselves OR super_admin only. Tenant
      // admins read this via the listAdmins / per-user lookup CFs which
      // scope by tenant on the server.
      allow read: if isOwner(uid) || isAdmin();
      allow write: if isAdmin();
    }

    match /users/{uid} {
      // Tenant-admin reads are gated on the CALLER's active-tenant claim
      // matching ANY of the target user's tenant memberships (not just their
      // current active tenantId). Using the array form means a user who is
      // still in `tenantIds` but has switched their active tenantId remains
      // readable by the admin of the org they actually belong to.
      allow read: if isOwner(uid) || isAdmin() ||
        (isTenantMember() &&
          ('tenantIds' in resource.data
            ? callerTenantId() in resource.data.tenantIds
            : resource.data.tenantId == callerTenantId()));
      // Stripe + tenant-membership fields must not be present at create time.
      // Tenant attachment flows exclusively through the joinTenant CF, which
      // validates the invite + writes both tenantId and tenantIds via Admin SDK.
      allow create: if isOwner(uid) &&
          validUserDoc(uid) &&
          hasNoStripeFields() &&
          hasNoTenantIdField();
      // Stripe fields and isBlocked are not writable from the client — CFs own
      // them via Admin SDK. NOTE: hasNoStripeFieldsWritten() and
      // isBlockedNotChanged() check the diff (not request.resource.data)
      // because the full doc may include CF-written fields.
      // tenantId AND tenantIds are managed exclusively by CFs — clients may
      // never write them on update either (closes the self-attach attack).
      allow update: if isOwner(uid) &&
          validUserDoc(uid) &&
          hasNoStripeFieldsWritten() &&
          isBlockedNotChanged() &&
          hasNoMembershipFieldsWritten();
      allow delete: if false;

      // Per-tenant state: pushka balance, goal, streak, auto-empty schedule.
      // Clients may read/write their own tenantState docs; CFs write via Admin SDK.
      match /tenantState/{tenantStateId} {
        allow read: if isOwner(uid);
        allow create: if isOwner(uid) && validTenantStateDoc(uid, tenantStateId);
        allow update: if isOwner(uid) && validTenantStateUpdateDoc(uid, tenantStateId);
        allow delete: if false;
      }

      match /transactions/{transactionId} {
        // Tenant members may read transactions that belong to their tenant.
        // New transactions carry tenantId on the doc itself (cheap check).
        // Legacy transactions lack tenantId — fall back to the parent user doc.
        allow read: if isOwner(uid) || isAdmin() ||
          (isTenantMember() && (
            'tenantId' in resource.data
              ? resource.data.tenantId == callerTenantId()
              : get(/databases/$(database)/documents/users/$(uid)).data.tenantId == callerTenantId()
          ));
        allow create: if isOwner(uid) && validTransactionDoc();
        allow update, delete: if false;
      }

      match /reminders/{reminderId} {
        allow read: if isOwner(uid);
        // Belt + suspenders: validReminderDoc().hasOnly() already excludes
        // server-owned fields (nextTriggerAt/lastTriggeredAt/timezone). The
        // extra hasNoServerOnlyReminderFieldsWritten() check makes intent
        // explicit and catches any future rule regression.
        allow create, update: if isOwner(uid) &&
            validReminderDoc() &&
            hasNoServerOnlyReminderFieldsWritten();
        allow delete: if isOwner(uid);
      }

      match /fcmTokens/{tokenId} {
        allow read: if isOwner(uid);
        allow create, update: if isOwner(uid) && validTokenDoc(tokenId);
        allow delete: if isOwner(uid);
      }

      match /paymentEvents/{eventId} {
        allow read: if isOwner(uid);
        allow write: if false;
      }

    }

    // Collection-group read para /users/*/transactions — powers el
    // widget "Donaciones en vivo" del dashboard del Rab (onSnapshot en
    // pushka_admin). Firestore requiere un rule separado para
    // collectionGroup queries; el rule del subcollection de arriba solo
    // aplica a direct-path reads. Stricter que el subcollection: la tx
    // DEBE tener tenantId (legacy tenantless docs no matchean el
    // where(tenantId==X) filter igualmente). Sin escritura — writes
    // siguen gated en el rule de arriba.
    match /{path=**}/transactions/{transactionId} {
      allow read: if isAdmin() ||
        (isTenantMember() &&
         'tenantId' in resource.data &&
         resource.data.tenantId == callerTenantId());
    }
  }
}

