rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.admin == true ||
        request.auth.token.role == 'super_admin'
      );
    }

    function isSuperAdmin() {
      return isSignedIn() && request.auth.token.role == 'super_admin';
    }

    function isTenantAdmin() {
      return isSignedIn() && request.auth.token.role == 'tenant_admin';
    }

    function isTenantCollaborator() {
      return isSignedIn() && request.auth.token.role == 'tenant_collaborator';
    }

    function callerTenantId() {
      return request.auth.token.tenantId;
    }

    function isTenantMember() {
      return isTenantAdmin() || isTenantCollaborator();
    }

    function validFrequency(value) {
      return value == 'manual' ||
          value == 'weekly' ||
          value == 'monthly' ||
          value == 'erev_rosh_chodesh';
    }

    // tenantId on users/{uid} must reference an existing tenants/{id} document.
    // Without this, any user could self-assign an arbitrary tenantId string
    // and appear as a member of that tenant in `where(tenantId == X)` queries.
    function validTenantIdField() {
      return !('tenantId' in request.resource.data) ||
          (request.resource.data.tenantId is string &&
              request.resource.data.tenantId.size() > 0 &&
              request.resource.data.tenantId.size() <= 50 &&
              exists(/databases/$(database)/documents/tenants/$(request.resource.data.tenantId)));
    }

    // Fields that only Cloud Functions may write (server-side only).
    // hasNoStripeFields() is for CREATE (new doc must not contain them).
    // hasNoStripeFieldsWritten() is for UPDATE (checks the diff — existing CF-written
    // Stripe fields in the resulting doc are fine; writing/changing them is not).
    function hasNoStripeFields() {
      return !('stripeCustomerId' in request.resource.data) &&
             !('stripeDefaultPaymentMethodId' in request.resource.data) &&
             !('stripeDefaultPaymentMethodLast4' in request.resource.data) &&
             !('stripeDefaultPaymentMethodBrand' in request.resource.data) &&
             !('stripeCustomerIdPending' in request.resource.data);
    }

    function hasNoStripeFieldsWritten() {
      // On UPDATE, request.resource.data is the full resulting document — it may
      // include Stripe fields that Cloud Functions previously wrote (Admin SDK bypasses
      // rules). We must only check what is being *changed*, not what's already there.
      return !request.resource.data.diff(resource.data).affectedKeys()
               .hasAny(['stripeCustomerId',
                        'stripeDefaultPaymentMethodId',
                        'stripeDefaultPaymentMethodLast4',
                        'stripeDefaultPaymentMethodBrand',
                        'stripeCustomerIdPending']);
    }

    function isBlockedNotChanged() {
      // isBlocked is written exclusively by Cloud Functions (Admin SDK bypasses rules).
      // Clients may not change this field — only read it.
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['isBlocked']);
    }

    function validUserDoc(uid) {
      // hasOnly includes Stripe fields and isBlocked so that on UPDATE, pre-existing
      // CF-written fields in the resulting document don't fail the check.
      // Writing/changing those fields is separately blocked by the specific guards below.
      return request.resource.data.keys().hasOnly([
            'uid',
            'email',
            'displayName',
            'photoURL',
            'createdAt',
            'lastLoginAt',
            'billingEmail',
            'phoneNumber',
            'mailingAddress',
            'pushkaAmount',
            'pushkaGoal',
            'presetAmount',
            'presetAmounts',
            'soundEnabled',
            'coinJingleEnabled',
            'vibrationEnabled',
            'ambientEnabled',
            'partialPaymentsEnabled',
            'additionalPaymentOptionsEnabled',
            'biometricAuthenticationEnabled',
            'currencyCountry',
            'currencyCode',
            'autoEmptyFrequency',
            'autoEmptyWeekday',
            'autoEmptyDayOfMonth',
            'autoEmptyTopOffEnabled',
            'autoEmptyTopOffAmount',
            'autoEmptyNextRunAt',
            'lastStreakDate',
            'streakCount',
            'reminderCount',
            'onboardingCompleted',
            'language',
            'updatedAt',
            'stripeCustomerId',
            'stripeDefaultPaymentMethodId',
            'stripeDefaultPaymentMethodLast4',
            'stripeDefaultPaymentMethodBrand',
            'stripeCustomerIdPending',
            'isBlocked',
            'tenantId'
          ]) &&
          request.resource.data.uid is string &&
          request.resource.data.uid == uid &&
          (!('pushkaAmount' in request.resource.data) ||
              (request.resource.data.pushkaAmount is number &&
                  request.resource.data.pushkaAmount >= 0 &&
                  request.resource.data.pushkaAmount <= 100000)) &&
          (!('pushkaGoal' in request.resource.data) ||
              (request.resource.data.pushkaGoal is number &&
                  request.resource.data.pushkaGoal > 0 &&
                  request.resource.data.pushkaGoal <= 100000)) &&
          (!('presetAmount' in request.resource.data) ||
              (request.resource.data.presetAmount is number &&
                  request.resource.data.presetAmount > 0)) &&
          (!('presetAmounts' in request.resource.data) ||
              (request.resource.data.presetAmounts is list &&
                  request.resource.data.presetAmounts.size() <= 5)) &&
          (!('soundEnabled' in request.resource.data) ||
              request.resource.data.soundEnabled is bool) &&
          (!('coinJingleEnabled' in request.resource.data) ||
              request.resource.data.coinJingleEnabled is bool) &&
          (!('vibrationEnabled' in request.resource.data) ||
              request.resource.data.vibrationEnabled is bool) &&
          (!('ambientEnabled' in request.resource.data) ||
              request.resource.data.ambientEnabled is bool) &&
          (!('partialPaymentsEnabled' in request.resource.data) ||
              request.resource.data.partialPaymentsEnabled is bool) &&
          (!('additionalPaymentOptionsEnabled' in request.resource.data) ||
              request.resource.data.additionalPaymentOptionsEnabled is bool) &&
          (!('biometricAuthenticationEnabled' in request.resource.data) ||
              request.resource.data.biometricAuthenticationEnabled is bool) &&
          (!('currencyCountry' in request.resource.data) ||
              request.resource.data.currencyCountry is string) &&
          (!('currencyCode' in request.resource.data) ||
              (request.resource.data.currencyCode is string &&
                  request.resource.data.currencyCode.size() == 3)) &&
          (!('autoEmptyFrequency' in request.resource.data) ||
              (request.resource.data.autoEmptyFrequency is string &&
                  validFrequency(request.resource.data.autoEmptyFrequency))) &&
          (!('autoEmptyWeekday' in request.resource.data) ||
              (request.resource.data.autoEmptyWeekday is int &&
                  request.resource.data.autoEmptyWeekday >= 1 &&
                  request.resource.data.autoEmptyWeekday <= 7)) &&
          (!('autoEmptyDayOfMonth' in request.resource.data) ||
              (request.resource.data.autoEmptyDayOfMonth is int &&
                  request.resource.data.autoEmptyDayOfMonth >= 1 &&
                  request.resource.data.autoEmptyDayOfMonth <= 31)) &&
          (!('autoEmptyTopOffEnabled' in request.resource.data) ||
              request.resource.data.autoEmptyTopOffEnabled is bool) &&
          (!('autoEmptyTopOffAmount' in request.resource.data) ||
              (request.resource.data.autoEmptyTopOffAmount is number &&
                  request.resource.data.autoEmptyTopOffAmount >= 0)) &&
          (!('autoEmptyNextRunAt' in request.resource.data) ||
              request.resource.data.autoEmptyNextRunAt is timestamp ||
              request.resource.data.autoEmptyNextRunAt == null) &&
          (!('email' in request.resource.data) ||
              (request.resource.data.email is string &&
                  request.resource.data.email.size() <= 254)) &&
          (!('displayName' in request.resource.data) ||
              (request.resource.data.displayName is string &&
                  request.resource.data.displayName.size() <= 100)) &&
          (!('billingEmail' in request.resource.data) ||
              (request.resource.data.billingEmail is string &&
                  request.resource.data.billingEmail.size() <= 254)) &&
          (!('phoneNumber' in request.resource.data) ||
              (request.resource.data.phoneNumber is string &&
                  request.resource.data.phoneNumber.size() <= 30)) &&
          (!('mailingAddress' in request.resource.data) ||
              (request.resource.data.mailingAddress is string &&
                  request.resource.data.mailingAddress.size() <= 500)) &&
          (!('photoURL' in request.resource.data) ||
              (request.resource.data.photoURL is string &&
                  request.resource.data.photoURL.size() <= 2048)) &&
          (!('reminderCount' in request.resource.data) ||
              (request.resource.data.reminderCount is int &&
                  request.resource.data.reminderCount >= 0)) &&
          (!('onboardingCompleted' in request.resource.data) ||
              request.resource.data.onboardingCompleted is bool) &&
          (!('language' in request.resource.data) ||
              (request.resource.data.language is string &&
                  (request.resource.data.language == 'es' ||
                      request.resource.data.language == 'en' ||
                      request.resource.data.language == 'fr' ||
                      request.resource.data.language == 'he')));
    }

    function validTransactionDoc() {
      return request.resource.data.keys().hasOnly([
            'type',
            'amount',
            'description',
            'paymentMethod',
            'status',
            'currencyCode',
            'tenantId',
            'createdAt'
          ]) &&
          (request.resource.data.type == 'tzedaka' ||
              request.resource.data.type == 'pushkaEmpty') &&
          request.resource.data.amount is number &&
          // Amount must be positive and within a sane ceiling (100 000 in major currency units).
          request.resource.data.amount > 0 &&
          request.resource.data.amount <= 100000 &&
          // createdAt must equal the server request time — prevents backdating / future-dating.
          request.resource.data.createdAt == request.time &&
          (!('description' in request.resource.data) ||
              (request.resource.data.description is string &&
                  request.resource.data.description.size() <= 500)) &&
          (!('paymentMethod' in request.resource.data) ||
              (request.resource.data.paymentMethod is string &&
                  request.resource.data.paymentMethod.size() <= 100)) &&
          (!('status' in request.resource.data) ||
              (request.resource.data.status is string &&
                  request.resource.data.status.size() <= 50)) &&
          (!('currencyCode' in request.resource.data) ||
              (request.resource.data.currencyCode is string &&
                  request.resource.data.currencyCode.size() == 3)) &&
          // Optional tenantId — when present, must match the user's own tenantId
          // (read from the parent users/{uid} doc) so users can't tag a tx as
          // belonging to a different tenant for accounting purposes.
          (!('tenantId' in request.resource.data) ||
              (request.resource.data.tenantId is string &&
                  request.resource.data.tenantId == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.tenantId));
    }

    function validReminderDoc() {
      return request.resource.data.keys().hasOnly([
            'title',
            'timeHour',
            'timeMinute',
            'days',
            'isHoliday',
            'minutesBefore',
            'isEnabled',
            'secondTimeHour',
            'secondTimeMinute',
            'secondDays',
            'secondIsHoliday',
            'createdAt'
          ]) &&
          request.resource.data.title is string &&
          request.resource.data.title.size() <= 100 &&
          request.resource.data.timeHour is int &&
          request.resource.data.timeHour >= 0 &&
          request.resource.data.timeHour <= 23 &&
          request.resource.data.timeMinute is int &&
          request.resource.data.timeMinute >= 0 &&
          request.resource.data.timeMinute <= 59 &&
          request.resource.data.days is list &&
          request.resource.data.days.size() <= 7 &&
          request.resource.data.isHoliday is bool &&
          (!('minutesBefore' in request.resource.data) ||
              request.resource.data.minutesBefore == null ||
              (request.resource.data.minutesBefore is int &&
                  request.resource.data.minutesBefore >= 0 &&
                  request.resource.data.minutesBefore <= 1440)) &&
          request.resource.data.isEnabled is bool &&
          request.resource.data.secondDays is list &&
          request.resource.data.secondDays.size() <= 7 &&
          request.resource.data.secondIsHoliday is bool &&
          (
            (
              (!('secondTimeHour' in request.resource.data) || request.resource.data.secondTimeHour == null) &&
              (!('secondTimeMinute' in request.resource.data) || request.resource.data.secondTimeMinute == null)
            ) ||
            (
              request.resource.data.secondTimeHour is int &&
              request.resource.data.secondTimeHour >= 0 &&
              request.resource.data.secondTimeHour <= 23 &&
              request.resource.data.secondTimeMinute is int &&
              request.resource.data.secondTimeMinute >= 0 &&
              request.resource.data.secondTimeMinute <= 59
            )
          );
    }

    function validTokenDoc(tokenId) {
      return request.resource.data.keys().hasOnly([
            'token',
            'platform',
            'createdAt',
            'lastUsedAt'
          ]) &&
          request.resource.data.token is string &&
          // FCM tokens are typically 140–200 characters; reject obviously bogus values.
          request.resource.data.token.size() >= 100 &&
          request.resource.data.token.size() <= 4096 &&
          request.resource.data.token == tokenId &&
          request.resource.data.platform is string &&
          (request.resource.data.platform == 'android' ||
              request.resource.data.platform == 'ios');
    }

    // Tenants — branding and config for each organization
    match /tenants/{tenantId} {
      // Super admin: full read/write
      allow read, write: if isAdmin();
      // Tenant admin and collaborator: read only their own tenant (for branding)
      allow read: if isTenantMember() && callerTenantId() == tenantId;
    }

    // Internal collections — server-side only, deny all client access.
    match /_rateLimits/{document=**} {
      allow read, write: if false;
    }
    match /_exchangeRates/{document=**} {
      allow read, write: if false;
    }
    match /_tenantSlugs/{slug} {
      allow read, write: if false;
    }
    match /_stripeWebhookEvents/{document=**} {
      allow read, write: if false;
    }

    // Admin-only config and notes collections
    match /adminConfig/{document} {
      allow read, write: if isAdmin();
    }

    match /adminData/{uid} {
      allow read, write: if isAdmin();
    }

    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin() ||
        (isTenantMember() && resource.data.tenantId == callerTenantId());
      // Stripe fields must not be present — they are written exclusively by CFs.
      // tenantId, if present, must reference an existing tenants/{id} doc.
      allow create: if isOwner(uid) &&
          validUserDoc(uid) &&
          hasNoStripeFields() &&
          validTenantIdField();
      // Stripe fields and isBlocked are not writable from the client — CFs own
      // them via Admin SDK. NOTE: hasNoStripeFieldsWritten() and
      // isBlockedNotChanged() check the diff (not request.resource.data)
      // because the full doc may include CF-written fields.
      allow update: if isOwner(uid) &&
          validUserDoc(uid) &&
          hasNoStripeFieldsWritten() &&
          isBlockedNotChanged() &&
          // tenantId is immutable once set — prevents tenant-hopping attacks.
          // When first being set, must reference an existing tenant.
          (
            !('tenantId' in resource.data)
              ? validTenantIdField()
              : request.resource.data.tenantId == resource.data.tenantId
          );
      allow delete: if false;

      match /transactions/{transactionId} {
        allow read: if isOwner(uid) || isAdmin();
        allow create: if isOwner(uid) && validTransactionDoc();
        allow update, delete: if false;
      }

      match /reminders/{reminderId} {
        allow read: if isOwner(uid);
        allow create, update: if isOwner(uid) && validReminderDoc();
        allow delete: if isOwner(uid);
      }

      match /fcmTokens/{tokenId} {
        allow read: if isOwner(uid);
        allow create, update: if isOwner(uid) && validTokenDoc(tokenId);
        allow delete: if isOwner(uid);
      }

      match /paymentEvents/{eventId} {
        allow read: if isOwner(uid);
        allow write: if false;
      }

    }
  }
}

