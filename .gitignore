.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Secrets & credentials - NEVER commit these
# Note: lib/firebase_options.dart (the env-picker wrapper) IS committed —
# it just imports the per-env files below and chooses based on --dart-define=ENV.
# The per-env Firebase configs are per-dev — generate with flutterfire configure.
lib/firebase_options_dev.dart
lib/firebase_options_prod.dart
android/app/google-services.json
ios/Runner/GoogleService-Info.plist
macos/Runner/GoogleService-Info.plist
.env
.env.local
.env.production
.env.*.local
# Catch-all for any *.env file (dev.env, production.env, etc.) so per-env
# secrets bundles can never accidentally get committed. .env.example is safe —
# the leading dot means *.env doesn't match it.
*.env
*.keystore
*.jks
key.properties
credentials.json
service-account*.json
**/firebase_options.dart.bak
google-services*.json
GoogleService-Info*.plist

# Temporary screenshots & test images
screenshot_*.png
pushka_brand_screenshot.png
pushka_v*.png
test1_*.png
test2_*.png
test_screenshots/
run_dev.sh
run.ps1
